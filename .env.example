# Grok Credentials (required for browser automation)
GROK_USERNAME=your_grok_username
GROK_PASSWORD=your_grok_password

# ElevenLabs API Key (optional, for TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Project Configuration
PROJECTS_DIR=./projects
BROWSER_HEADLESS=true
BROWSER_TYPE=chromium

# Grok Base URL (default: x.com/grok)
GROK_BASE_URL=https://grok.x.ai

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5

# Video Generation Timeout (seconds)
VIDEO_GEN_TIMEOUT=300
